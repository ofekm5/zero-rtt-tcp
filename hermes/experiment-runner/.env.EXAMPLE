CLAUDE_CODE_OAUTH_TOKEN=
OPENROUTER_API_KEY=
GITHUB_TOKEN=
ZERO_RTT_REPO_PATH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=

# Do NOT set ANTHROPIC_API_KEY here. Anthropic auth resolves
# ANTHROPIC_API_KEY -> ANTHROPIC_AUTH_TOKEN -> OAuth token, so a stray key wins
# over everything else and silently switches this profile to per-token billing.

# Do NOT add AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN, or
# AWS_PROFILE to this file. This fleet reaches AWS only through GitHub Actions,
# which holds the OIDC role. An AWS credential here removes the isolation the
# whole design rests on, and nothing in this profile needs one.

# GITHUB_TOKEN scope: actions:write + contents:read on ofekm5/zero-rtt-tcp.
# NOT contents:write — this agent dispatches workflows, it never commits.
