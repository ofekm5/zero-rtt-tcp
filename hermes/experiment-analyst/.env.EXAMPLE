CLAUDE_CODE_OAUTH_TOKEN=
OPENROUTER_API_KEY=
GITHUB_TOKEN=
ZERO_RTT_REPO_PATH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=

# Do NOT set ANTHROPIC_API_KEY here. Anthropic auth resolves
# ANTHROPIC_API_KEY -> ANTHROPIC_AUTH_TOKEN -> OAuth token, so a stray key wins
# over everything else and silently switches this profile to per-token billing.

# Do NOT add AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN, or
# AWS_PROFILE to this file. This agent reads committed git artifacts and has no
# reason to reach AWS.

# GITHUB_TOKEN scope: contents:read ONLY on ofekm5/zero-rtt-tcp.
# Not actions:write — the analyst must not be able to start a paid run.
# Not contents:write — the analyst must not be able to commit.
# Use a DIFFERENT token from the runner's: least privilege only holds if the
# scopes actually differ, and one shared PAT gives this agent dispatch rights.
