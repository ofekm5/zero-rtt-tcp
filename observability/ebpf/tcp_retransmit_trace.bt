#!/usr/bin/env bpftrace
// tcp_retransmit_trace.bt — trace TCP retransmits for a given port
//
// Usage: bpftrace tcp_retransmit_trace.bt [port]
//   port  TCP port to filter (default: 8080)
//
// Output: one JSON line per retransmit event matching the port:
//   {"ts_ns": <nsecs>, "src": "<ip>", "dst": "<ip>", "sport": <n>, "dport": <n>,
//    "seq": <n>, "state": <n>}
//
// Note: seq is read from the TCP header in the sk_buff (best-effort).

BEGIN
{
    @port = ($1 == 0) ? (uint64)8080 : $1;
}

tracepoint:tcp:tcp_retransmit_skb
/(args->sport == @port || args->dport == @port)/
{
    // Read seq from TCP header: skb->head + transport_header offset + 4 bytes
    // (TCP header layout: src_port[2] + dst_port[2] + seq[4] + ...)
    $skb  = (struct sk_buff *)args->skbaddr;
    $seq  = bswap(*(uint32 *)($skb->head + (uint16)$skb->transport_header + 4));

    printf("{\"ts_ns\": %llu, \"src\": \"%s\", \"dst\": \"%s\", \"sport\": %d, \"dport\": %d, \"seq\": %u, \"state\": %d}\n",
        nsecs,
        ntop(2, args->saddr),
        ntop(2, args->daddr),
        args->sport,
        args->dport,
        $seq,
        args->state);
}

END
{
    clear(@port);
}
