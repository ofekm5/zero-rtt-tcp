#!/usr/bin/env bpftrace
// tcp_state_trace.bt — trace TCP state transitions for a given port
//
// Usage: bpftrace tcp_state_trace.bt [port]
//   port  TCP port to filter (default: 8080)
//
// Output: one JSON line per state transition matching the port:
//   {"ts_ns": <nsecs>, "src": "<ip>", "dst": "<ip>", "sport": <n>, "dport": <n>,
//    "old_state": "<name>", "new_state": "<name>"}

BEGIN
{
    @port = ($1 == 0) ? (uint64)8080 : $1;

    @state[1]  = "TCP_ESTABLISHED";
    @state[2]  = "TCP_SYN_SENT";
    @state[3]  = "TCP_SYN_RECV";
    @state[4]  = "TCP_FIN_WAIT1";
    @state[5]  = "TCP_FIN_WAIT2";
    @state[6]  = "TCP_TIME_WAIT";
    @state[7]  = "TCP_CLOSE";
    @state[8]  = "TCP_CLOSE_WAIT";
    @state[9]  = "TCP_LAST_ACK";
    @state[10] = "TCP_LISTEN";
    @state[11] = "TCP_CLOSING";
    @state[12] = "TCP_NEW_SYN_RECV";
}

tracepoint:sock:inet_sock_set_state
/args->protocol == 6 && (args->sport == @port || args->dport == @port)/
{
    printf("{\"ts_ns\": %llu, \"src\": \"%s\", \"dst\": \"%s\", \"sport\": %d, \"dport\": %d, \"old_state\": \"%s\", \"new_state\": \"%s\"}\n",
        nsecs,
        ntop(args->family, args->saddr),
        ntop(args->family, args->daddr),
        args->sport,
        args->dport,
        @state[args->oldstate],
        @state[args->newstate]);
}

END
{
    clear(@state);
    clear(@port);
}
